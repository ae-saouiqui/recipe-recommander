    {
      "text": "// Split the data \nimport org.apache.spark.sql.functions.{col,split,lower,array_contains}\n// From the dataset countries are separated with \",\",so we can split into an array using it as separator\n// Ensure the countries match the same cases.\nval split_countries_col \u003d split(lower(col(\"countries_en\")),\",\")\n// Check if \"italy\" or \"japan\" exists in array of countries\nval japan_italy_filter \u003d array_contains(split_countries_col,\"italy\").or(array_contains(split_countries_col,\"japan\"))",
      "user": "anonymous",
      "dateUpdated": "2025-05-31 13:37:29.420",
      "progress": 0,
      "config": {
        "colWidth": 12.0,
        "fontSize": 9.0,
        "results": {},
        "enabled": true,
        "editorSetting": {
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "results": {
        "code": "SUCCESS",
        "msg": [
          {
            "type": "TEXT",
            "data": "import org.apache.spark.sql.functions.{col, split, lower, array_contains}\n\u001b[1m\u001b[34msplit_countries_col\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Column\u001b[0m \u003d split(lower(countries_en), ,, -1)\n\u001b[1m\u001b[34mjapan_italy_filter\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Column\u001b[0m \u003d (array_contains(split(lower(countries_en), ,, -1), italy) OR array_contains(split(lower(countries_en), ,, -1), japan))\n"
          }
        ]
      },
