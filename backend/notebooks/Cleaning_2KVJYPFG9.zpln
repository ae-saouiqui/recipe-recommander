    {
      "text": "// replacing f -\u003e e a+ -\u003e a and not-applicable/uknown -\u003e null\nimport org.apache.spark.sql.functions.upper\nval eco_score_grade_col \u003d col(\"environmental_score_grade\")\nval ecoscore_filter \u003d upper(when(eco_score_grade_col\u003d\u003d\u003d\"f\",\"e\")\n.when(eco_score_grade_col \u003d\u003d\u003d \"a-plus\",\"a\")\n.when(eco_score_grade_col \u003d\u003d\u003d \"not-applicable\",null)\n.when(eco_score_grade_col \u003d\u003d\u003d \"unknown\",null)\n.otherwise(eco_score_grade_col))",
      "user": "anonymous",
      "dateUpdated": "2025-05-31 13:39:24.932",
      "progress": 0,
      "config": {
        "colWidth": 12.0,
        "fontSize": 9.0,
        "results": {},
        "enabled": true,
        "editorSetting": {
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        }
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "results": {
        "code": "SUCCESS",
        "msg": [
          {
            "type": "TEXT",
            "data": "import org.apache.spark.sql.functions.upper\n\u001b[1m\u001b[34meco_score_grade_col\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Column\u001b[0m \u003d environmental_score_grade\n\u001b[1m\u001b[34mecoscore_filter\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Column\u001b[0m \u003d upper(CASE WHEN (environmental_score_grade \u003d f) THEN e WHEN (environmental_score_grade \u003d a-plus) THEN a WHEN (environmental_score_grade \u003d not-applicable) THEN NULL WHEN (environmental_score_grade \u003d unknown) THEN NULL ELSE environmental_score_grade END)\n"
          }
        ]
      },
