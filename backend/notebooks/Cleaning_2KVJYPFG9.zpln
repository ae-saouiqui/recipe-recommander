    {
      "text": "%spark\n// Now from score to grade \ndef score_to_grade(score:Int):String \u003d {\n    score match {\n        case x if x \u003c\u003d 39 \u003d\u003e \"E\"\n        case x if x \u003e\u003d40 \u0026\u0026 x\u003c55 \u003d\u003e \"D\"\n        case x if x \u003e\u003d55 \u0026\u0026 x\u003c70 \u003d\u003e \"C\"\n        case x if x \u003e\u003d70 \u0026\u0026 x\u003c80 \u003d\u003e \"B\"\n        case x if x \u003e\u003d80 \u003d\u003e \"A\"\n    }\n}",
