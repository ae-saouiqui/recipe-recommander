      "text": "%spark\n// Split the data \nimport org.apache.spark.sql.functions.{col,split,lower,array_contains}\n// From the dataset countries are separated with \",\",so we can split into an array using it as separator\n// Ensure the countries match the same cases.\nval split_countries_col \u003d split(lower(col(\"countries_en\")),\",\")\n// Check if \"italy\" or \"japan\" exists in array of countries\nval japan_italy_filter \u003d array_contains(split_countries_col,\"italy\").or(array_contains(split_countries_col,\"japan\"))\n\nval source_df_1 \u003d source_df.filter(japan_italy_filter)",
      "user": "anonymous",
      "dateUpdated": "2025-06-01 13:50:34.227",
      "progress": 0,
      "config": {
