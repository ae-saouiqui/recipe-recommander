      "text": "import org.apache.spark.sql.functions.{col, when, lit, lower}\n\nval source_df_7 \u003d source_df_6.withColumn(\n  \"additives\",\n  when(\n    // Si les deux sont null ou unknown ⇒ -1\n    (col(\"additives_tags\").isNull || (lower(col(\"additives_tags\")) \u003d\u003d\u003d \"unknown\")) \u0026\u0026\n    (col(\"additives_n\").isNull || (lower(col(\"additives_n\")) \u003d\u003d\u003d \"unknown\")), \n    lit(-1) // Correct use of lit with a numeric value\n  ).when(\n    // Si au moins un des deux contient des additifs ⇒ 1\n    (col(\"additives_n\") \u003e 0) ||\n    ((col(\"additives_tags\").isNotNull) \u0026\u0026 (lower(col(\"additives_tags\")) \u003d!\u003d \"unknown\")),\n    lit(1) // Correct use of lit with a numeric value\n  ).otherwise(lit(0)) // sinon ⇒ 0 (présence explicite de 0 additif)\n)\n",
