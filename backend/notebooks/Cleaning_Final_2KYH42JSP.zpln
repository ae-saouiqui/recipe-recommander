    {
      "text": "import org.apache.spark.sql.functions._\nimport org.apache.spark.sql.DataFrame\n\n// List of allergen columns\nval allergenCols \u003d Seq(\n  \"contains_milk\", \"contains_eggs\", \"contains_fish\", \"contains_shellfish\",\n  \"contains_tree_nuts\", \"contains_peanuts\", \"contains_wheat\",\n  \"contains_soybeans\", \"contains_gluten\"\n)\n\n// Create a column that sums the allergen indicators (assuming boolean columns)\nval allergenCountCol \u003d allergenCols\n  .map(c \u003d\u003e when(col(c) \u003d\u003d\u003d true, 1).otherwise(0))\n  .reduce(_ + _)\n\n// Add the allergen count column\nval dfWithAllergenCount \u003d transformed_df.withColumn(\"allergen_count\", allergenCountCol)\n\n// Apply rule-based logic to fill nova_group\nval dfFilled \u003d dfWithAllergenCount.withColumn(\"nova_group\",\n  when(col(\"nova_group\").isNull \u0026\u0026 col(\"additives\") \u003d\u003d\u003d true, lit(4))\n    .when(col(\"nova_group\").isNull \u0026\u0026 col(\"additives\") \u003d\u003d\u003d false \u0026\u0026 col(\"allergen_count\") \u003c\u003d 2, lit(1))\n    .when(col(\"nova_group\").isNull \u0026\u0026 col(\"additives\") \u003d\u003d\u003d false \u0026\u0026 col(\"allergen_count\") \u003e 2, lit(3))\n    .when(col(\"nova_group\").isNull, lit(0)) // Default fallback\n    .otherwise(col(\"nova_group\"))\n).drop(\"allergen_count\")\n",
