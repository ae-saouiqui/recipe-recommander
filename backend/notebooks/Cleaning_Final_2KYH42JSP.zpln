    {
      "text": "import org.apache.spark.sql.functions.{col, when, lit, lower, map, map_filter, to_json}\n\n// Adding the \"serving_info\" column to the source_df_1 DataFrame\nval source_df_6 \u003d source_df_5.withColumn(\n  \"serving_info\",\n  when(\n    // Condition: If either \"serving_size\" or \"quantity\" is not null and not \"unknown\"\n    ((col(\"serving_size\").isNotNull) \u0026\u0026 (lower(col(\"serving_size\")) \u003d!\u003d \"unknown\")) ||\n    ((col(\"quantity\").isNotNull) \u0026\u0026 (lower(col(\"quantity\")) \u003d!\u003d \"unknown\")),\n    // If the condition is true, create a JSON string with \"serving_size\" and \"quantity\"\n    to_json(  // Convert map to JSON string\n      map_filter(\n        map(\n          // Map creation\n          lit(\"serving_size\"), when(\n            (col(\"serving_size\").isNotNull) \u0026\u0026 (lower(col(\"serving_size\")) \u003d!\u003d \"unknown\"),\n            col(\"serving_size\") // Value from \"serving_size\" column\n          ).otherwise(lit(null)),  // Use otherwise to ensure null is handled\n          lit(\"quantity\"), when(\n            (col(\"quantity\").isNotNull) \u0026\u0026 (lower(col(\"quantity\")) \u003d!\u003d \"unknown\"),\n            col(\"quantity\") // Value from \"quantity\" column\n          ).otherwise(lit(null))  // Use otherwise to ensure null is handled\n        ),\n        // Filter out entries with null values\n        ((k, v) \u003d\u003e v.isNotNull)\n      )\n    )\n  ).otherwise(lit(\"unknown\")) // If the condition is false, set value to \"unknown\"\n)\n",
      "user": "anonymous",
      "dateUpdated": "2025-06-01 13:50:51.320",
      "progress": 0,
