      "text": "import org.apache.spark.sql.functions._\nimport org.apache.spark.sql.{Column,DataFrame}\n\nval source_df_9 \u003d source_df_8.withColumn(\n    \"_ingredients_str\",\n    concat_ws(\",\", col(\"ingredients_tags\"))\n)\n// Define the processIngredients function\ndef processIngredients(df: DataFrame): DataFrame \u003d {\n\n  val commonAllergens \u003d Seq(\n    \"milk\", \"eggs\", \"fish\", \"shellfish\", \"tree nuts\", \"peanuts\", \n    \"wheat\", \"soybeans\", \"gluten\"\n  )\n\n  var dfWithAllergens \u003d df\n\n  // Add columns for each allergen\n  commonAllergens.foreach { allergen \u003d\u003e\n    val allergenColumn \u003d when(col(\"_ingredients_str\").isNull, lit(false))\n      .otherwise(\n        lower(col(\"_ingredients_str\")).contains(allergen) ||\n        lower(coalesce(col(\"allergens\"), lit(\"\"))).contains(allergen)\n      ).cast(\"int\")\n\n    dfWithAllergens \u003d dfWithAllergens.withColumn(\n      s\"contains_${allergen.replace(\" \", \"_\")}\",\n      allergenColumn\n    )\n  }\n\n  // Combine allergen columns into a new \"allergenes\" column\n  val allergenCols \u003d commonAllergens.map(allergen \u003d\u003e\n    col(s\"contains_${allergen.replace(\" \", \"_\")}\")\n  )\n  dfWithAllergens \u003d dfWithAllergens.withColumn(\"allergenes\", allergenCols.reduce(_ + _))\n\n  // Step 3: Add is_vegetarian column using `!` for logical negation\n  dfWithAllergens \u003d dfWithAllergens.withColumn(\n    \"is_vegetarian\",\n    when(col(\"_ingredients_str\").isNull, lit(null))\n      .otherwise(\n        !(lower(col(\"_ingredients_str\")).contains(\"meat\") ||\n        lower(col(\"_ingredients_str\")).contains(\"chicken\") ||\n        lower(col(\"_ingredients_str\")).contains(\"beef\") ||\n        lower(col(\"_ingredients_str\")).contains(\"pork\") ||\n        lower(col(\"_ingredients_str\")).contains(\"fish\"))\n      )\n  )\n\n  // Step 4: Add is_vegan column using `!` for logical negation\n  dfWithAllergens \u003d dfWithAllergens.withColumn(\n    \"is_vegan\",\n    when(col(\"ingredients_text\").isNull, lit(null))\n      .otherwise(\n        col(\"is_vegetarian\") \u0026\u0026\n        !(lower(col(\"_ingredients_str\")).contains(\"milk\") ||\n        lower(col(\"_ingredients_str\")).contains(\"egg\") ||\n        lower(col(\"_ingredients_str\")).contains(\"honey\") ||\n        lower(col(\"_ingredients_str\")).contains(\"cheese\"))\n      )\n  )\n\n  dfWithAllergens\n}\n\n// Apply the function to the DataFrame\nval dfProcessed \u003d processIngredients(source_df_9)\n\n// Drop the temporary \"_ingredients_str\" column\nval source_df_10 \u003d dfProcessed.drop(\"_ingredients_str\")\n",
      "user": "anonymous",
