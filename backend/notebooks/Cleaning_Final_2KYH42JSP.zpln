      "text": "import org.apache.spark.sql.functions._\nimport org.apache.spark.sql.Column\n\n// Define the clean_and_split function\ndef cleanAndSplit(colName: String): Column \u003d {\n  expr(s\"transform(split($colName, \u0027,\u0027), x -\u003e lower(regexp_replace(x, \u0027^.*?:\u0027, \u0027\u0027)))\")\n}\n\n// List of columns to merge\nval columnsToMerge \u003d Seq(\"categories_tags\", \"food_groups_tags\", \"food_groups\", \"main_category\")\n\n// Initialize merged_array as null\nvar mergedArray: Column \u003d lit(null)\n\n// Dynamically merge all columns\nfor (colName \u003c- columnsToMerge) {\n  val cleanedArray \u003d when(col(colName).isNotNull, cleanAndSplit(colName)).otherwise(array())\n  if (mergedArray \u003d\u003d lit(null)) {\n    mergedArray \u003d cleanedArray\n  } else {\n    mergedArray \u003d array_union(mergedArray, cleanedArray)\n  }\n}\n\n// Apply array_distinct to remove duplicates and create the final \"combined_tags\" column\nval dfCleaned \u003d source_df_7.withColumn(\"combined_tags_temp\", array_distinct(mergedArray))\n\n// Replace empty arrays with null\nval dfCleanedWithTags \u003d dfCleaned.withColumn(\n  \"combined_tags\",\n  when(size(col(\"combined_tags_temp\")) \u003d\u003d\u003d 0, lit(null)).otherwise(col(\"combined_tags_temp\"))\n).drop(\"combined_tags_temp\")\n\n// Create the pnns_list column\nval dfWithPnnsList \u003d dfCleanedWithTags.withColumn(\n  \"pnns_list\",\n  array(\n    when((col(\"pnns_groups_1\").isNotNull) \u0026\u0026 (lower(col(\"pnns_groups_1\")) \u003d!\u003d \"unknown\"), col(\"pnns_groups_1\")).otherwise(lit(null)),\n    when((col(\"pnns_groups_2\").isNotNull) \u0026\u0026 (lower(col(\"pnns_groups_2\")) \u003d!\u003d \"unknown\"), col(\"pnns_groups_2\")).otherwise(lit(null))\n  )\n)\n\n// Create the categories column by flattening the arrays, removing nulls, and lowercasing\nval source_df_8\u003d dfWithPnnsList.withColumn(\n  \"categories\",\n  expr(\"\"\"\n    array_distinct(\n      transform(\n        filter(flatten(array(combined_tags, pnns_list)), x -\u003e x is not null),\n        x -\u003e lower(x)\n      )\n    )\n  \"\"\")\n)\n",
