    {
      "text": "%pyspark\n# Create a pipeline \nfrom pyspark.ml import Pipeline\nvec_pipeline \u003d Pipeline(\n    stages \u003d [\n        tokenizer,\n        remover,\n        hashingTF,\n        idf\n    ]\n)",
