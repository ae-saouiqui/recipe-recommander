    {
      "text": "%pyspark\n# Define the list of allowed countries\nallowed_countries \u003d [\u0027united-states\u0027, \u0027united-kingdom\u0027, \u0027canada\u0027, \u0027italy\u0027, \u0027france\u0027, \u0027japan\u0027, \u0027germany\u0027]\n\n# Create a new column with the filtered array using array_intersect\ndf \u003d df.withColumn(\n    \u0027filtered_countries\u0027, \n    F.array_intersect(F.col(\u0027countries_tags\u0027), F.array(*[F.lit(country) for country in allowed_countries]))\n)\n\ndf \u003d df.drop(\"countries_tags\")\\\n.withColumnRenamed(\"filtered_countries\",\"countries_tags\")\n\n",
      "user": "anonymous",
      "dateUpdated": "2025-06-03 12:31:19.324",
