    {
      "text": "%pyspark\n#  Ingredient and category pools (adjust as needed)\ningredients_pool \u003d [\n    \"water\", \"glycerin\", \"sodium_chloride\", \"citric_acid\", \"fragrance\", \n    \"cocamidopropyl_betain\", \"sodium_benzoate\", \"aloe_vera\", \"vitamin_e\", \n    \"shea_butter\", \"caffeine\", \"jojoba_oil\", \"lavender_oil\", \"tea_tree_oil\",\n    \"benzyl_alcohol\", \"caprylyl_glycol\"\n]\n\ncategories_pool \u003d [\n    \"skincare\", \"haircare\", \"bodycare\", \"makeup\", \"fragrance\", \n    \"natural\", \"organic\", \"vegan\", \"cruelty_free\", \"anti_aging\"\n]\n\ndef generate_random_sample(num_samples\u003d1):\n    data \u003d []\n    for i in range(num_samples):\n        sample \u003d {\n            # \"ingredients_tags\": [\"sugar\",\"salt\",\"flour\"],\n            \"categories\": [\"unsweetened-beverages\", \"plant-based-foods\", \"condiments\", \"spices\", \"ginger\", \"groceries\"],\n            \"product_name\":\"Corn flakes\"\n            # Add other necessary columns your pipeline expects here, with dummy or random values\n            # \"additives\": random.choice([0,1]),\n            # \"contains_eggs\": random.choice([0,1]),\n            # \"contains_fish\": random.choice([0,1]),\n            # \"contains_gluten\": random.choice([0,1]),\n            # \"contains_milk\": random.choice([0,1]),\n            # \"contains_peanuts\": random.choice([0,1]),\n            # \"contains_shellfish\": random.choice([0,1]),\n            # \"contains_soybeans\": random.choice([0,1]),\n            # \"contains_tree_nuts\": random.choice([0,1]),\n            # \"contains_wheat\": random.choice([0,1]),\n            # \"nutriscore_grade\": random.choice([\"a\", \"b\", \"c\",\"d\", \"e\"]).upper(),\n            # \"ecoscore\": random.choice([\"a\", \"b\", \"c\",\"d\", \"e\"]).upper(),\n            # \"nova_group\": random.choice([1, 2, 3, 4]),\n            # Add any other columns your vectorizer depends on...\n        }\n        data.append(sample)\n    return data\n\n# Generate sample data\nsample_data \u003d generate_random_sample(1)\n\n# Create Spark DataFrame\ndf_sample \u003d spark.createDataFrame(sample_data)\ndf_sample.show()",
