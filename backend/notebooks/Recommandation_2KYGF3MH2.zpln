    {
      "text": "%pyspark\n# Add product name\nfrom pyspark.ml.feature import Tokenizer, StopWordsRemover,HashingTF,IDF\n\n# Step 1: Tokenize\ntokenizer \u003d Tokenizer(inputCol\u003d\"product_name\", outputCol\u003d\"product_name_tokens\")\n\n# Step 2: Remove stopwords (optional)\nremover \u003d StopWordsRemover(inputCol\u003d\"product_name_tokens\", outputCol\u003d\"product_name_filtered\")\n\n# Step 3: HashingTF to convert tokens to raw feature vectors\nhashingTF \u003d HashingTF(inputCol\u003d\"product_name_filtered\", outputCol\u003d\"product_name_tf\", numFeatures\u003d1000)\n\n# Step 4: IDF to rescale features\nidf \u003d IDF(inputCol\u003d\"product_name_tf\", outputCol\u003d\"product_name_vec\")\n\n# Then add these stages to your existing pipeline\n",
      "user": "anonymous",
      "dateUpdated": "2025-06-03 12:39:17.062",
