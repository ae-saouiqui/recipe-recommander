    },
    {
      "text": "%pyspark\nfrom pyspark.sql.functions import udf, col\nfrom pyspark.sql.types import DoubleType\nimport numpy as np\n\ndef cosine_similarity_with_query(df, vector_col, query_vector, ascending\u003dFalse):\n    \"\"\"\n    Compute cosine similarity between each vector in df[vector_col] and query_vector.\n    Return a DataFrame with an added \u0027cosine_similarity\u0027 column sorted by similarity.\n\n    Parameters:\n    - df: Spark DataFrame with vector column\n    - vector_col: name of the vector column in df (string)\n    - query_vector: pyspark.ml.linalg.Vector (query vector)\n    - ascending: bool, True to sort ascending, False descending (default)\n\n    Returns:\n    - DataFrame with \u0027cosine_similarity\u0027 column sorted by similarity\n    \"\"\"\n\n    def cosine_sim(v):\n        arr1 \u003d v.toArray()\n        arr2 \u003d query_vector.toArray()\n        dot \u003d float(np.dot(arr1, arr2))\n        norm1 \u003d float(np.linalg.norm(arr1))\n        norm2 \u003d float(np.linalg.norm(arr2))\n        if norm1 \u003d\u003d 0 or norm2 \u003d\u003d 0:\n            return 0.0\n        return dot / (norm1 * norm2)\n\n    cosine_sim_udf \u003d udf(cosine_sim, DoubleType())\n\n    df_with_sim \u003d df.withColumn(\"cosine_similarity\", cosine_sim_udf(col(vector_col)))\n    sorted_df \u003d df_with_sim.orderBy(col(\"cosine_similarity\").asc() if ascending else col(\"cosine_similarity\").desc())\n    return sorted_df\n",
      "user": "anonymous",
      "dateUpdated": "2025-06-01 23:41:13.997",
      "progress": 0,
      "config": {
